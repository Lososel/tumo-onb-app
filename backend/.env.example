# "mock" reads data/mock_sheet.json, "csv" reads exported tabs (CSV_PATH), "google" reads the live Google Sheet.
DATA_SOURCE=mock

# DATA_SOURCE=csv: a .csv file or a folder of them (one file per tab). Never commit real exports.
CSV_PATH=data/csv

# Required when DATA_SOURCE=google
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEET_ID=

# Alternative to GOOGLE_CREDENTIALS_FILE: the whole service-account JSON as one value
# (takes precedence; escaped "\n" in the private key is handled). Never commit it.
GOOGLE_CREDENTIALS_JSON=

# Sheet unreachable and no cache yet: lookups answer "unavailable" (HTTP 200).
# true = serve the mock dataset instead (demo/staging only).
FALLBACK_TO_MOCK=false

# Seconds between background syncs from the source.
SYNC_INTERVAL_SECONDS=300

# Only search tabs whose name contains this text (case/space-insensitive), e.g. "4 поток".
# Empty = all tabs. If no tab matches, all tabs are used and a warning is logged.
TAB_FILTER=

# Where the last good snapshot is persisted (served instantly on restart / outages).
CACHE_FILE=data/cache/snapshot.json

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Max lookups per client IP per minute.
LOOKUP_RATE_LIMIT_PER_MINUTE=30

# Optional: set to enable POST /api/admin/refresh (header "X-Admin-Token") to force an
# immediate re-sync after editing the sheet. Leave empty to disable.
ADMIN_TOKEN=

# Built frontend to serve from the API process (run `npm run build` in frontend/ first).
# Ignored if the folder doesn't exist.
STATIC_DIR=../frontend/dist

# Include the sheet's temporary password ("Пароль") in lookup responses. Off by default;
# enable only during onboarding and turn it off again afterwards.
EXPOSE_TEMP_PASSWORD=false

# Number of reverse proxies that append to X-Forwarded-For (Render: 1). Rate limiting uses the
# client IP they recorded; 0 = use the direct peer address.
PROXY_HOPS=0
